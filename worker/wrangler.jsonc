{
  "name": "ai-support-rag-api",
  "main": "index.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "vpc_services": [{ "binding": "N8N", "service_id": "01a08b3a-5cac-7320-a09b-c224460a527a" }],
  "ratelimits": [{ "name": "RAG_RATE", "namespace_id": "810246", "simple": {"limit":30,"period":60} }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_ORIGIN": "https://ai-support-rag-demo.pages.dev",
    "OPENROUTER_MODEL": "nex-agi/nex-n2.5-mini:free",
    "LLM_ENABLED": "true",
    "LLM_DAILY_LIMIT": "20",
    "SIMILARITY_THRESHOLD": "0.66"
  }
}
